<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FNSBuildTools</AssemblyName>
    <RootNamespace>Farvane.BuildTools</RootNamespace>
    <Version>0.8.0</Version>
    <Authors>Farvane Naval Systems</Authors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>
  <ItemGroup>
    <GameReference Include="Avalonia.Base;Avalonia.Controls;Game2.Client;Game2.Simulation;VRage.Core;VRage.Core.Game;VRage.Library;VRage.Multiplayer;VRage.UI;VRage.UI.Shared;VRage.Input;VRage.DCS;VRage.Game.Client;VRage.Physics;VRage.Render" />
    <Reference Include="@(GameReference)">
      <HintPath>$(Game2Path)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="VerifyGamePath" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(Game2Path)/VRage.Core.dll')" Text="Supply -p:Game2Path=your installed SE2 Game2 directory" />
  </Target>
</Project>
